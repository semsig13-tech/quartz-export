{
  "name": "quartz-export",
  "version": "0.1.0",
  "private": false,
  "description": "Client-side DOCX/PDF export for Quartz v5 sites",
  "type": "module",
  "exports": { ".": "./dist/index.js" },
  "files": ["dist", "src", "static", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup src/index.ts src/client.ts --format esm --dts --clean --out-dir dist --external @quartz-community/types",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "docx": "^9.5.1",
    "html2pdf.js": "^0.10.3",
    "marked": "^15.0.12"
  },
  "devDependencies": {
    "@quartz-community/types": "^1.0.0",
    "@types/node": "^22.13.10",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
